# 依赖
node_modules/
web/node_modules/
web/dist/

# 环境变量（含真实 cookie，绝不提交）
.env

# 运行日志与临时产物
logs/
*.log

# 答案数据（用户自行生成，不随仓库分发）
data/answers/*.json
!data/answers/.gitkeep

# 本地答案数据库（包含课程题目与采集结果）
data/answer-db/
data/discussion-state/
data/workflow/

# Go binaries, local infrastructure and secret material
bin/
.local/
secrets/
coverage.out
internal/webassets/assets/*
!internal/webassets/assets/.gitkeep

# Local tunnel credentials and server configuration
tunnel.yml
.env.*
!.env.example

# Public-source privacy boundary
cases/
reports/
exports/
backups/
*.pgdump
*.dump
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.pem
*.key
*.p12
*.pfx
*.bak
.DS_Store
