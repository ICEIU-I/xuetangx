APP_ENV=development
DATABASE_URL=postgres://developer@127.0.0.1:5432/xuetangx
PUBLIC_BASE_URL=http://127.0.0.1:8788
LISTEN_ADDR=127.0.0.1:8788
CREDENTIAL_KEY_FILE=./secrets/credential_keys.json
SMTP_ADDRESS=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD_FILE=
MAX_ACTIVE_JOBS=10
MAX_ACTIVE_JOBS_PER_USER=2

# Registration email verification defaults ON in the database.
# Administrators can change the policy in system settings.
# MAIL_ENABLED controls SMTP availability, not the verification policy.
MAIL_ENABLED=false
# Exact proxy IPs only: tunnel connector and/or host gateway observed from the app.
# Production Compose requires PUBLIC_BASE_URL=https://your-domain and this value.
TRUSTED_PROXY_CIDRS=
# Compose: choose a subnet not used by other Docker networks.
EDGE_SUBNET=10.254.88.0/24
TUNNEL_IP=10.254.88.3
RELEASE=latest

# Optional standalone persistence; production Compose uses a dedicated volume.
TRAFFIC_FILE=
