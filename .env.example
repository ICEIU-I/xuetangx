# 复制为 .env 后填写。换课程 / 换账号只改这里。

# 课程固定参数（从课程学习页 URL / 抓包获取）
# 学习页 URL 形如：.../learn/space/<SIGN>/<SIGN>/<CLASSROOM_ID>/...
CLASSROOM_ID=000000
SKU_ID=000000
SIGN=your_course_sign

# 提交并发数（建议 1，配合下方间隔配速，避免触发服务器限速）
CONCURRENCY=1
# 每题提交间隔(ms)，约 50 题/分钟，贴着服务器限速留余量
SUBMIT_INTERVAL_MS=1200
# 单题遇限速时的退避重试次数
MAX_RETRY=6

# 登录态 cookie（也可在 Web 控制台里填，二选一）
# 浏览器 F12 → Network → 任意请求复制 Cookie 头，须含 sessionid 和 csrftoken
COOKIE=

